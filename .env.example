# ClimateTransit environment variables
# Copy to .env.local (gitignored). Production values live in Vercel Environment Variables.

# Gemini API key — used ONLY inside the Vercel Function (api/summary.ts).
# NEVER prefix with VITE_ (that would ship the key to the browser).
GEMINI_API_KEY=

# Default SSP scenario the UI opens with.
VITE_DEFAULT_SCENARIO=ssp245
